      var mag_npv = S_syn_mag.select('NPV').rename(str2.cat('NPV_MAG'));
      var mag_ndvi = S_syn_mag.select('NDVI').rename(str2.cat('NDVI_MAG'));
      var mag_nbr = S_syn_mag.select('NBR').rename(str2.cat('NBR_MAG'));
      
      //abrupt_loss only is 2
      //syn ab_combine_deg_cnf
      var ab_combine_cnf = mag_soil.add(mag_npv).subtract(mag_shade).subtract(mag_NDFI)
      var abrupt_loss_cnf = ee.Image(2).updateMask(cnf_forest_mask)
                                      .updateMask(ab_combine_cnf.gt(2300*(ab_threshold/100)))
                                    //  .updateMask(mag_nbr.gt(0.1))

     
      //syn nMAG_NDFI_deg_mix
      var nMAG_NDFI_deg_mix = mag_NDFI.multiply(-1).divide(ccdcInput.select(str2.cat('NDFI_RMSE')))
      var abrupt_loss_mix = ee.Image(2).updateMask(mix_forest_mask)
                                      .updateMask(nMAG_NDFI_deg_mix.gt(1*(ab_threshold/100)))
                                  //    .updateMask(mag_nbr.gt(0.1))

      //org ab_combine_deg_cdc
      var ab_combine_deg_dcd = seg_bands.select(str2.cat('Soil_MAG'))
                      .subtract(seg_bands.select(str2.cat('NDFI_MAG')))
                      .subtract(seg_bands.select(str2.cat('GV_MAG')));
                      
      var abrupt_loss_dcd = ee.Image(2).updateMask(dcd_forest_mask)
                          .updateMask(ab_combine_deg_dcd.gt(4000*ab_threshold/100))

                   
      var abrupt_loss = ee.ImageCollection([abrupt_loss_cnf.toInt8(),
                        abrupt_loss_mix.toInt8(),abrupt_loss_dcd.toInt8()]).mosaic()    
                                
     
      // Add a threshold for change probability 
      var chProb_mask = seg_bands.select(str2.cat('changeProb')).gt(ch_prob);

      abrupt_loss = abrupt_loss.updateMask(chProb_mask).toInt8();
 
      //If both the value is 3
      var both = ee.Image(3).updateMask(gradual_loss.and(abrupt_loss))
      var forest_loss = ee.ImageCollection([abrupt_loss, gradual_loss, both]).mosaic()
      // Make names for bands
      var segStr = ee.String('S').cat(ee.String(ee.Number(seg).int8()));
      var className = segStr.cat('_forest_loss');
      var startName = segStr.cat('_tStart');
      var breakName = segStr.cat('_tBreak');
      var breakMonthName = segStr.cat('_tBreakMonth');

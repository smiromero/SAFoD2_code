/* ----------------- Topographic correction: --------------------- */


// Función combinada de corrección topográfica con IC y método SCSc
function topographicCorrection(img) {
  // Constantes y preparación

  var geometry = img.geometry().buffer(10000);
  var degree2radian = Math.PI / 180;
  var dem = ee.Image("USGS/SRTMGL1_003").clip(geometry);

  var sunElevation = ee.Number(img.get('SUN_ELEVATION'));
  var sunAzimuth = ee.Number(img.get('SUN_AZIMUTH'));

  // Calcular ángulos solares en radianes
  var SZ_rad = ee.Image.constant(ee.Number(90).subtract(sunElevation).multiply(degree2radian));
  var SA_rad = ee.Image.constant(sunAzimuth.multiply(degree2radian));

  // Calcular pendiente y orientación en radianes
  var slope = ee.Terrain.slope(dem).rename('slope');
  var slp_rad = slope.multiply(degree2radian);
  var asp_rad = ee.Terrain.aspect(dem).multiply(degree2radian);

  // Calcular componentes de la condición de iluminación
  var cosZ = SZ_rad.cos();
  var cosS = slp_rad.cos();
  var sinZ = SZ_rad.sin();
  var sinS = slp_rad.sin();
  var cosAziDiff = SA_rad.subtract(asp_rad).cos();

  var slope_illumination = cosZ.multiply(cosS);
  var aspect_illumination = sinZ.multiply(sinS).multiply(cosAziDiff);
  var IC = slope_illumination.add(aspect_illumination).rename('IC');

  // Agregar bandas necesarias al original
  var img_plus_ic = img
    .addBands(IC)
    .addBands(cosZ.rename('cosZ'))
    .addBands(cosS.rename('cosS'))
    .addBands(slope);

  // Máscara para aplicar SCSc
  var mask2 = img_plus_ic.select('slope').gte(5)
    .and(img_plus_ic.select('IC').gte(0))
    .and(img_plus_ic.select('NIR').gt(-0.1));
  var img_masked = img_plus_ic.updateMask(mask2);

  // Bandas a corregir
  var bandList = ['BLUE', 'GREEN', 'RED', 'NIR', 'SWIR1', 'SWIR2'];
  var nonCorrectBands = img.select(img.bandNames().removeAll(bandList));

  // Función para aplicar la corrección SCSc a cada banda
  function applySCSc(bandName) {
    var fit = img_masked.select(['IC', bandName]).reduceRegion({
      reducer: ee.Reducer.linearFit(),
      geometry: geometry.buffer(-5000),
      scale: 300,
      maxPixels: 1e9
    });

    var a = ee.Number(fit.get('scale'));
    var b = ee.Number(fit.get('offset'));
    var c = b.divide(a);

    return ee.Algorithms.If(
      fit,
      img_masked.expression(
        '((image * (cosS * cosZ + c)) / (IC + c))',
        {
          'image': img_masked.select(bandName),
          'IC': img_masked.select('IC'),
          'cosS': img_masked.select('cosS'),
          'cosZ': img_masked.select('cosZ'),
          'c': c
        }
      ).rename(bandName),
      img_masked.select(bandName)
    );
  }

  // Aplicar corrección a todas las bandas seleccionadas
  var correctedBands = ee.Image(bandList.map(function(b) {
    return applySCSc(b);
  })).addBands(img_plus_ic.select('IC'));

  var bandList_IC = ee.List(bandList).add('IC');
  correctedBands = correctedBands
    .unmask(img_plus_ic.select(bandList_IC))
    .select(bandList);

  // Reconstruir imagen final
  var final = correctedBands
    .addBands(nonCorrectBands)
    .setMulti(img.toDictionary())
    .set('system:time_start', img.get('system:time_start'));

  return ee.Image(final);
}


/*--------------- Unmixing calculation CCDC-SMA -------------------*/
// Function obtained from Share Repo: users/shijuanchen32/forest_degradation_georgia/utilities/ut_workflow

var unmixing = function(col, endMembers) {   
  var gv = endMembers.gv;
  var npv = endMembers.npv;
  var soil = endMembers.soil;
  var shade = endMembers.shade;
  var cloud = endMembers.cloud;
  var cfThreshold = endMembers.cfThreshold;
   

  
  return col.map(function(img){
    
    var ndvi = img.normalizedDifference(['NIR', 'RED']).multiply(10000).rename('NDVI');
    var nbr = img.normalizedDifference(['NIR', 'SWIR2']).multiply(10000).rename('NBR');
    var wetness = img.expression(
        '(L1 * B1) + (L2 * B2) + (L3 * B3) + (L4 * B4) + (L5 * B5) + (L6 * B6)',
        {
            'L1': img.select('BLUE'),
            'B1': 0.0315,
            'L2': img.select('GREEN'),
            'B2': 0.2021,
            'L3': img.select('RED'),
            'B3': 0.3102,
            'L4': img.select('NIR'),
            'B4': 0.1594,
            'L5': img.select('SWIR1'),
            'B5': -0.6806,
            'L6': img.select('SWIR2'),
            'B6': -0.6109
        }).multiply(10000).rename('WETNESS')
    var unmixed = img.select(['BLUE', 'GREEN', 'RED', 'NIR', 'SWIR1', 'SWIR2'])
                    .unmix([gv, shade, npv, soil, cloud], true, true)
                    .rename(['GV','Shade','NPV','Soil','Cloud']);
    var maskCloud = unmixed.select('Cloud').lt(cfThreshold);
    var maskShade = unmixed.select('Shade').lt(1);
    
    var NDFI = unmixed.expression(
          '10000 * ((GV / (1 - SHADE)) - (NPV + SOIL)) / ((GV / (1 - SHADE)) + (NPV + SOIL))', 
          {
            'GV': unmixed.select('GV'),
            'SHADE': unmixed.select('Shade'),
            'NPV': unmixed.select('NPV'),
            'SOIL': unmixed.select('Soil')
          }).rename('NDFI');
          
    var maskNDFI = unmixed.expression(
        '(GV / (1 - SHADE)) + (NPV + SOIL)', 
        {
          'GV': unmixed.select('GV'),
          'SHADE': unmixed.select('Shade'),
          'NPV': unmixed.select('NPV'),
          'SOIL': unmixed.select('Soil')
        }).gt(0);
    return img.addBands(unmixed.select(['GV','Shade','NPV','Soil']).multiply(10000))
              .addBands(NDFI).addBands(ndvi).addBands(nbr).addBands(wetness)
              .updateMask(maskCloud).updateMask(maskNDFI).updateMask(maskShade)
  });
};
 
 

function classifySegments(geo, ccdc, params_cl,  ab_threshold, gr_threshold, ch_prob) {
  var SEGS = ["S1", "S2", "S3", "S4", "S5", "S6"];
  var bands = ['GV', 'Shade', 'NPV', 'Soil', 'NDFI', 'NDVI','WETNESS', 'NBR'];
  var numberOfSegments = SEGS.length;
  //the newBuildCcdcImage_deg only retrived coefs for degradation,
  //whereas the newBuildCcdcImage retrived all coefs
  var ccdcInput = newBuildCcdcImage_deg(ccdc, SEGS.length, bands);
  
  //get image collection of synthetic images
  var syn_col = [];
  var start_y = params_cl.get('start_year').getInfo();
  var end_y = params_cl.get('end_year').getInfo(); 
  
  for (var y = (start_y-1); y <= end_y; y++){
    var date = y.toString() + '-07-31';
    var syn_image = get_syn(ccdc, date);
    //create a mask that fitler when all endmembers are zero
    var sum_mask = syn_image.select('Soil').add(syn_image.select('NPV')).add(syn_image.select('Shade')).add(syn_image.select('GV')); 
    var syn_image_output = syn_image.updateMask(sum_mask).setMulti({'year':y});
    syn_col.push(syn_image_output);
  }
  syn_col = ee.ImageCollection(syn_col);
  
  var dcd_forest_mask = ee.Image(params_cl.get('forest_type')).eq(params_cl.get('dcd').getInfo());
  var cnf_forest_mask = ee.Image(params_cl.get('forest_type')).eq(params_cl.get('cnf').getInfo());
  var mix_forest_mask = ee.Image(params_cl.get('forest_type')).eq(params_cl.get('mix').getInfo());
 

  
  var forest_mask = dcd_forest_mask.or(cnf_forest_mask).or(mix_forest_mask).selfMask()

  // Map over segments
  var segmentsClassified = ee.List.sequence(1, numberOfSegments)
    .map(function(seg) {

  // Another string to remove segment prefix
      var str = ee.String('S')
        .cat(ee.String(ee.Number(seg).int8()))
        .cat('.*')

      // Another string to remove segment prefix
      var str2 = ee.String('S')
        .cat(ee.String(ee.Number(seg).int8()))
        .cat('_');
        
      // Select bands to classify 
      var imageToClassify = ccdcInput;
      var seg_bands = imageToClassify.select([str])
      //
      var numobs_mask = seg_bands.select(str2.cat('numObs')).gt(20)
      
      seg_bands = seg_bands.updateMask(seg_bands.select(str2.cat('tStart')).gt(0))

      //gradual_loss_only is 1
      var Soil_SLP = seg_bands.select(str2.cat('Soil_coef_SLP'));
      var deg_soil = Soil_SLP.gt(0.1).updateMask(numobs_mask)
      var gradual_loss = ee.Image(1).updateMask(deg_soil).updateMask(forest_mask).toInt8();
      
      var S_tBreak = ccdcInput.select(str2.cat('tBreak'));

      var S_tBreak_y = get_year(S_tBreak).updateMask(S_tBreak);

      var S_tBreak_b = S_tBreak_y.subtract(1);
      var S_tBreak_a = S_tBreak_y.add(1);
      
      var mag_collection = [];
      for(var i = start_y; i <= (end_y-1); i++){   
        
        var year_mask = S_tBreak_y.updateMask(S_tBreak_y.eq(ee.Image(i)));
      
        var previous = syn_col.filterMetadata('year', "less_than", i).sort('year', true).mosaic(); //if previous, use ascending order (in case the previous year snythetic image is not avaliable)
      
        var later = syn_col.filterMetadata('year', "greater_than", i).sort('year', false).mosaic(); //if later, use descending order (in case the later year snythetic image is not avaliable)
      
        var mag_syn = later.subtract(previous).updateMask(year_mask)
      
        mag_collection.push(mag_syn)
      }
      //for the last year
      i = end_y;
      
      year_mask = S_tBreak_y.updateMask(S_tBreak_y.eq(ee.Image(i)));
    
      previous = syn_col.filterMetadata('year', "less_than", i).sort('year', true).mosaic(); //if previous, use ascending order
    
      later = syn_col.filterMetadata('year', "equals", end_y).mosaic(); 
    
      mag_syn = later.subtract(previous).updateMask(year_mask)
    
      mag_collection.push(mag_syn)


      var S_syn_mag = ee.ImageCollection(mag_collection).mosaic().updateMask(forest_mask);
      var mag_NDFI = S_syn_mag.select('NDFI').rename(str2.cat('NDFI_MAG')); 
      var mag_soil = S_syn_mag.select('Soil').rename(str2.cat('Soil_MAG'));
